{
  "manifest_version": 3,
  "name": "NeumoTab",
  "version": "0.1.0",
  "description": "A minimal and customizable new tab page for your browser.",
  "homepage_url": "https://github.com/sudachi443/NeumoTab",
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "homepage.html"
  },
  "action": {
    "default_title" : "NeumoTab",
    "default_popup" : "setting.html"
  },
     "options_ui": {
    "page": "setting.html",
    "open_in_tab": true
  }
}
